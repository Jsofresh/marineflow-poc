generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IntakeRequest {
  id             String      @id @default(cuid())
  customerName   String
  email          String?
  phone          String?
  vesselName     String?
  serviceRequest String
  location       String
  status         String      @default("NEW")
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  workOrders     WorkOrder[]
  activityLogs   ActivityLog[]
}

model WorkOrder {
  id              String      @id @default(cuid())
  intakeRequestId String
  status          String      @default("NEW")
  internalNotes   String?
  completedAt     DateTime?
  qbInvoiceId     String?
  qbSyncStatus    String      @default("PENDING")
  qbRetryCount    Int         @default(0)
  qbLastError     String?
  wallaceEntered   Boolean     @default(false)
  wallaceEnteredAt DateTime?
  wallaceExternalId String?
  wallaceSyncStatus String     @default("PENDING")
  createdAt        DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  intakeRequest IntakeRequest @relation(fields: [intakeRequestId], references: [id], onDelete: Cascade)
  activityLogs  ActivityLog[]
}

model ActivityLog {
  id              String        @id @default(cuid())
  entityType      ActivityEntity
  action          String
  message          String
  metadata        Json?
  workOrderId     String?
  intakeRequestId String?
  createdAt       DateTime      @default(now())

  workOrder    WorkOrder?    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  intakeRequest IntakeRequest? @relation(fields: [intakeRequestId], references: [id], onDelete: Cascade)

  @@index([workOrderId, createdAt])
  @@index([intakeRequestId, createdAt])
}

model WebhookEvent {
  id             String   @id @default(cuid())
  source         String
  eventType      String
  idempotencyKey String   @unique
  payload        Json
  status         String   @default("RECEIVED")
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([source, eventType, createdAt])
}

model WebhookInbox {
  id             String   @id @default(cuid())
  source         String
  eventType      String
  idempotencyKey String   @unique
  payloadHash    String
  payload        Json
  status         String   @default("RECEIVED")
  correlationId  String?
  error          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([source, eventType, createdAt])
  @@index([correlationId])
}

model EventOutbox {
  id            String   @id @default(cuid())
  eventType     String
  aggregateType String
  aggregateId   String
  dedupeKey     String   @unique
  correlationId String
  causationId   String?
  payload       Json
  status        String   @default("PENDING")
  attempts      Int      @default(0)
  nextAttemptAt DateTime @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status, nextAttemptAt])
  @@index([eventType, createdAt])
  @@index([correlationId])
}

model IntegrationAttempt {
  id             String   @id @default(cuid())
  provider       String
  operation      String
  externalKey    String
  status         String
  correlationId  String?
  requestHash    String?
  responseHash   String?
  responseCode   Int?
  retryable      Boolean  @default(false)
  error          String?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([provider, externalKey])
  @@index([provider, operation, createdAt])
  @@index([correlationId])
}

enum ActivityEntity {
  INTAKE
  WORK_ORDER
  QUICKBOOKS
}
